# ApnaTutor backend — environment variable reference
#
# Copy to .env and fill in. NEVER commit .env. Keep this file in sync whenever
# you add a variable — this is how the next person knows what to set.
#
# Loaded by spring.config.import in src/main/resources/application.yml.
# Backend-only: the frontend has its own frontend/.env.example.
#
# Everything here has a working local default in application.yml, except the
# Razorpay keys, which you only need once you reach M4.

# --- Database ----------------------------------------------------------------
APNATUTOR_DB_URL=jdbc:postgresql://localhost:5432/apnatutor_dev
APNATUTOR_DB_USER=apnatutor
APNATUTOR_DB_PASSWORD=apnatutor

APNATUTOR_TEST_DB_URL=jdbc:postgresql://localhost:5432/apnatutor_test
APNATUTOR_TEST_DB_USER=apnatutor
APNATUTOR_TEST_DB_PASSWORD=apnatutor

# Local PostgreSQL superuser password, used by scripts/db-reset.ps1 only.
PGPASSWORD=

# --- Security ----------------------------------------------------------------
# Minimum 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The default in application.yml is insecure and for local use only.
APNATUTOR_JWT_SECRET=

# --- URLs --------------------------------------------------------------------
# Where the frontend runs. Used for CORS and for links in emails and SMS.
APNATUTOR_FRONTEND_URL=http://localhost:3000
SERVER_PORT=8080

# --- Providers ---------------------------------------------------------------
# 'console' prints OTPs and emails to the backend log instead of sending them.
# Switch to a real provider only when going live.
APNATUTOR_SMS_PROVIDER=console
APNATUTOR_MAIL_PROVIDER=console

# --- Development conveniences -------------------------------------------------
# MUST BE false IN PRODUCTION. When true the app seeds test accounts with a
# fixed, published OTP and returns generated codes in API responses.
#
# You cannot leave this on by accident: DevModeGuard refuses to start the
# application if it is true alongside a real SMS provider or a 'prod' profile.
#
# Test accounts seeded when enabled:
#   9999900001  Student / Parent
#   9999900002  Tutor
#   9999900003  Admin
APNATUTOR_DEV_MODE=true
APNATUTOR_DEV_OTP=123456

# --- Rate limiting (M5-07) ---------------------------------------------------
# Per-IP allowances per minute. All optional; the defaults in application.yml
# are the ones below. Sized for "one address behaving badly", not "one person
# behaving normally" - Indian mobile networks use carrier-grade NAT, so one
# address can be a whole neighbourhood.
#
# Rate limiting is SKIPPED ENTIRELY while APNATUTOR_DEV_MODE is true.
#
# APNATUTOR_RATE_PUBLIC is large because the Next.js frontend renders public
# pages server-side: without X-Forwarded-For, every SEO page view arrives from
# the frontend server's one address. Raise it, or forward the visitor IP.
APNATUTOR_RATE_AUTH=20
APNATUTOR_RATE_ADMIN=120
APNATUTOR_RATE_PUBLIC=3000
APNATUTOR_RATE_API=300
# Per tutor, per hour - not an IP limit.
APNATUTOR_RATE_UNLOCKS=30

APNATUTOR_STORAGE_PROVIDER=local
APNATUTOR_STORAGE_PATH=./uploads

# --- Payments (needed from M4) -----------------------------------------------
# Razorpay TEST keys while developing. Live keys never go in a file.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
